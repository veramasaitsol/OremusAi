# ─────────────────────────────────────────────────────────────────────────────
# Oremus Frontend — environment template. Copy to `.env` and fill in real values.
# All VITE_* variables are read in one place: src/config/env.js
# ─────────────────────────────────────────────────────────────────────────────

# ─── API endpoints ───────────────────────────────────────────────────────────
# Backend API root — must include the `/api` prefix, no trailing slash.
# Chosen automatically by build mode in src/config/env.js:
#   • `npm run dev`   → http://localhost:5001/api   (local backend)
#   • `npm run build` → https://api.oremuscorp.ai/api (live)
# Leave unset to use that default; uncomment ONE line only to override.
# VITE_API_URL=http://localhost:5001/api
# VITE_API_URL=https://api.oremuscorp.ai/api
# AI query service base (frontend posts to `${VITE_AI_API_URL}/query`)
# Example production AI URL:
# VITE_AI_API_URL=https://oremuscorp.ai/api

# Vite dev-proxy target for `/api` (only used by `npm run dev`).
VITE_DEV_API=http://localhost:5001

# Oremus AI query service (separate origin from the main backend).
VITE_AI_API_URL=https://oremuscorp.ai

# Public marketing site URL (canonical links / JSON-LD).
VITE_SITE_URL=https://oremusai.vensframe.com

# ─── Zoho Books OAuth ────────────────────────────────────────────────────────
VITE_ZOHO_CLIENT_ID=your_zoho_client_id_here
VITE_ZOHO_REDIRECT_URI=http://localhost:5174/auth/zoho/callback
VITE_ZOHO_API_BASE=https://www.zohoapis.in/books/v3
VITE_ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2
VITE_ZOHO_AUTH_URL=https://accounts.zoho.in/oauth/v2/auth
VITE_ZOHO_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
VITE_ZOHO_ORG_ID=your_zoho_org_id_here

# ─── QuickBooks Online ───────────────────────────────────────────────────────
VITE_QBO_ENV=sandbox
