# ── Xero ──────────────────────────────────────────────────────────────────────
XERO_CLIENT_ID=1AF769FC1C5B49C592CFD3DB94D277CD
XERO_CLIENT_SECRET=73VttGrGhfAe_5XL8ovtLrO5lxi_5uU8JBD7hxhuql84RgLR
