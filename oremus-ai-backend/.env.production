#QBO_MINOR_VERSION=70


#  QB Production
QBO_CLIENT_ID=ABbIuceZE1L040g5PEFVvQkhLccBAZOawryw2rbL3zbNG4kQLB
QBO_CLIENT_SECRET=23A7m19XhDnCwdY2jxAoRCpTl2x9j5YChGdG1mxs
QBO_REDIRECT_URI=https://api.oremusai.vensframe.com/auth/quickbooks/callback
