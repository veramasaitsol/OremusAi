# ── Server ────────────────────────────────────────────────────────────────────
# cPanel Passenger sets PORT automatically — do NOT hardcode it
NODE_ENV=production

# ── MySQL (cPanel) ─────────────────────────────────────────────────────────────
# DB_HOST is usually localhost on cPanel (not 127.0.0.1, not 3306)
DB_HOST=localhost
DB_PORT=3306
# cPanel DB names are always prefixed: cpanelusername_dbname
DB_USER=cpanelusername_dbuser
DB_PASSWORD=your_db_password_here
DB_NAME=cpanelusername_oremus_db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a long random string in production — never use the dev default
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── Zoho OAuth ────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=1000.6OSYH4APOW7TWX4HY1J47NFQ8J2B4R
ZOHO_CLIENT_SECRET=7e9ef0c710254b5e366b792f6189d7610f067d0de5
# Must match EXACTLY what is registered in Zoho Developer Console.
# This must be the BACKEND URL (where your Node.js app runs), not the frontend.
# Example: https://api.oremusai.vensframe.com/api/auth/zoho/callback
#      OR: https://oremusai.vensframe.com/api/auth/zoho/callback  (if proxied)
ZOHO_REDIRECT_URI=https://api.oremusai.vensframe.com/auth/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ORG_ID=60069197945

# ── QuickBooks Online ─────────────────────────────────────────────────────────
# QBO_ENV controls which Intuit API base is used:
#   'sandbox'    → https://sandbox-quickbooks.api.intuit.com
#   'production' → https://quickbooks.api.intuit.com
# Reusing the development (sandbox) QBO app credentials — keep QBO_ENV=sandbox so
# the sandbox API base + sandbox company are used (production env base would reject
# these sandbox keys).
QBO_ENV=production
