# ── Frontend URL (CORS + OAuth redirects) ─────────────────────────────────────
FRONTEND_URL=https://oremusai.vensframe.com

# Backend root URL — used by /api/clients/:id/connect-zoho
BACKEND_URL=https://api.oremusai.vensframe.com